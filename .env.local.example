# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored - never committed.

# Required to let anyone other than this Mac reach the web UI:
AGENT_HOST=0.0.0.0
AGENT_PORT=5000
AGENT_PASSWORD=choose-a-real-password-here

# SMTP app passwords - only needed for Live mode email sending
SMTP_PASSWORD_SALES=
SMTP_PASSWORD_TARANNUM_GMAIL=
